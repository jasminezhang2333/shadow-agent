        "转成3D", "做成3D", "生成3D", "三维打印",
        "OBJ", "GLB", "STL", "USDZ",
        "3D", "三维", "模型"
      ],
      "negatives": [
        "3D风格图片", "3D效果图", "3D渲染图", "立体风格海报", "3D海报"
