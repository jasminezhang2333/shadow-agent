# Shadow Agent 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置

# ========== 必填配置 ==========

# DashScope API Key（通义千问）
# 申请地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ADB 设备序列号
# 获取方式: 运行 `adb devices` 查看
ADB_SERIAL=your-device-serial

# ========== 可选配置 ==========

# Gemini API Key（如使用 Gemini 模型）
GEMINI_API_KEY=

# 智谱 API Key（如使用 GLM-Realtime）
ZHIPU_API_KEY=

# 火山引擎配置（如使用豆包模型）
VOLC_AK=
VOLC_SK=
VOLC_APP_ID=
VOLC_RTC_APP_KEY=
DOUBAO_ENDPOINT_ID=
DOUBAO_API_KEY=

# 火山引擎语音技术配置
VOLC_SPEECH_APP_ID=
VOLC_SPEECH_TOKEN=
VOLC_SPEECH_SECRET=

# ========== 高级配置 ==========

# 关键词路由开关（1=开启，0=关闭）
KEYWORD_ROUTER_ENABLED=1

# DashScope 视频帧压缩配置
DASHSCOPE_VIDEO_COMPRESS=1
DASHSCOPE_VIDEO_MAX_B64=220000
DASHSCOPE_VIDEO_JPEG_Q=75
DASHSCOPE_VIDEO_MAX_LONG_EDGE=640

# realtime 网关地址（默认 localhost:8080/8081）
# GATEWAY_HTTP=http://127.0.0.1:8080
# GATEWAY_WS=ws://127.0.0.1:8081

# 向量数据库目录
# CHROMA_DIR=./.chroma_memory

# 代理设置（访问 Gemini 需要）
# HTTPS_PROXY=http://127.0.0.1:10090
# HTTP_PROXY=http://127.0.0.1:10090
